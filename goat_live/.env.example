# ============================================================
# GOAT Live Bot — .env configuration template
# Copy this file to goat_live/.env and fill in your values.
# NEVER commit the .env file to git.
# ============================================================

# --- Exchange selection ---
# Options: "bybit" or "hyperliquid"
GOAT_EXCHANGE=hyperliquid

# --- Testnet mode ---
# Set to true to connect to the exchange's testnet API (no real money).
GOAT_TESTNET=true

# --- Bybit API credentials (only needed if GOAT_EXCHANGE=bybit) ---
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# --- Hyperliquid credentials (only needed if GOAT_EXCHANGE=hyperliquid) ---
# Wallet address and private key for Hyperliquid L1 signing
HL_WALLET_ADDRESS=0xYourWalletAddress
HL_PRIVATE_KEY=your_private_key_here

# --- Trading parameters ---
GOAT_SYMBOL=BTC/USDC:USDC
# Candle timeframe — any exchange-supported value:
#   1m  3m  5m  15m  30m  1h  4h  1d
GOAT_TIMEFRAME=5m
GOAT_NOTIONAL_USD=20
GOAT_RR_RATIO=3.0
GOAT_PIVOT_LEN=2
GOAT_LEVERAGE=1

# --- Safety switch ---
# Set to false to trade real money. Leave true for paper-log mode.
GOAT_DRY_RUN=true

# --- Position mode (Bybit only) ---
# Set to true if your Bybit account uses hedge mode (separate long/short positions).
# Ignored for Hyperliquid (always one-way mode).
GOAT_HEDGE_MODE=true

# --- AO Filter ---
# Awesome Oscillator filter: only long if AO < 0, only short if AO > 0 (counter-trend entries).
# Set to true to enable, false to disable (default).
GOAT_AO_FILTER=false

# --- Logging ---
GOAT_LOG_LEVEL=INFO

# --- Internal tuning (optional) ---
# Number of bars to fetch for warmup / pattern detection
GOAT_WARMUP_BARS=500
# How often (seconds) the bot polls for a new closed candle.
# 15s is good for 1m, 60s better for 5m to reduce API calls.
GOAT_POLL_INTERVAL_SEC=60
